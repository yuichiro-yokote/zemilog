<Window x:Class="ZemiLog.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ゼミログ" Height="820" Width="1320" MinHeight="680" MinWidth="1050"
        Background="#F4F6F8" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="34"/></Style>
        <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="32"/><Setter Property="Margin" Value="3"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox"><Setter Property="MinHeight" Value="32"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="7,4"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="9"/><Setter Property="BorderBrush" Value="#DCE1E7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14"/></Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource Panel}" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ゼミログ" FontSize="25" FontWeight="SemiBold" Foreground="#17202A" Margin="3,0,18,0"/>
                    <TextBlock Text="録音・文字起こし・研究フィードバック整理" Foreground="#65717E" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="履歴" VerticalAlignment="Center" Margin="12,0,3,0"/>
                <ComboBox x:Name="HistoryCombo" Grid.Row="0" Grid.Column="3" DisplayMemberPath="DisplayName" SelectionChanged="HistoryCombo_SelectionChanged"/>
                <Button Grid.Row="0" Grid.Column="4" Content="更新" Click="Refresh_Click"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="マイク" VerticalAlignment="Center" Margin="3"/>
                <ComboBox x:Name="MicrophoneCombo" Grid.Row="1" Grid.Column="1" DisplayMemberPath="Name"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="相手の音" VerticalAlignment="Center" Margin="12,0,3,0"/>
                <ComboBox x:Name="ProcessCombo" Grid.Row="1" Grid.Column="3" DisplayMemberPath="Name"/>
                <Button Grid.Row="1" Grid.Column="4" Content="機器を再読込" Click="RefreshDevices_Click"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="発表資料" VerticalAlignment="Center" Margin="3"/>
                <TextBox x:Name="PresentationPathText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" IsReadOnly="True" ToolTip="PPTXの本文・発表者ノートを要約の文脈に使います"/>
                <Button Grid.Row="2" Grid.Column="3" HorizontalAlignment="Left" Content="PPTXを選択" Click="SelectPresentation_Click"/>
                <ComboBox x:Name="PlaybackModeCombo" Grid.Row="2" Grid.Column="4" Width="135">
                    <ComboBoxItem Content="ヘッドホン" Tag="Headphones" IsSelected="True"/><ComboBoxItem Content="スピーカー" Tag="Speakers"/>
                </ComboBox>
                <Expander Grid.Row="3" Grid.ColumnSpan="5" Header="Qwenの接続設定（音声は送信しません）" Margin="3,5,3,0">
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Base URL" VerticalAlignment="Center"/><TextBox x:Name="QwenBaseUrlText" Grid.Column="1" ToolTip="例: http://server:8000/v1/"/>
                        <TextBlock Grid.Column="2" Text="モデル" VerticalAlignment="Center" Margin="10,0,0,0"/><TextBox x:Name="QwenModelText" Grid.Column="3"/>
                        <TextBlock Grid.Column="4" Text="API Key" VerticalAlignment="Center" Margin="10,0,0,0"/><PasswordBox x:Name="QwenApiKeyBox" Grid.Column="5" Margin="3" Padding="7,4" MinHeight="32"/>
                        <Button Grid.Column="6" Content="保存・接続確認" Click="SaveAndTestQwen_Click"/>
                    </Grid>
                </Expander>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8"><TextBlock Text="文字起こし" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="QueueText" Text="待機中" Foreground="#65717E" HorizontalAlignment="Right"/></DockPanel>
                    <ListBox x:Name="TranscriptList" Grid.Row="1" ItemsSource="{Binding TranscriptRows}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#EBEEF2" BorderThickness="0,0,0,1" Padding="4,9"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Time}" Foreground="#77808A"/><TextBlock Grid.Column="1" Text="{Binding Speaker}" FontWeight="SemiBold" Foreground="{Binding SpeakerColor}"/><TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"/>
                        </Grid></Border></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Border Grid.Column="2" Style="{StaticResource Panel}"><Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8"><TextBlock Text="その時点での要約" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="SummaryUpdatedText" Foreground="#65717E" HorizontalAlignment="Right"/></DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="SummaryText" Text="録音開始後、約45秒ごとに更新します。" TextWrapping="Wrap" FontSize="14" LineHeight="22"/></ScrollViewer>
            </Grid></Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="StartButton" Grid.Column="0" Content="● 録音開始" Background="#C62828" Foreground="White" FontWeight="SemiBold" Click="Start_Click"/>
            <Button x:Name="StopButton" Grid.Column="1" Content="■ 録音停止" IsEnabled="False" Click="Stop_Click"/><Button x:Name="SummarizeButton" Grid.Column="2" Content="今すぐ要約" Click="Summarize_Click"/>
            <Button x:Name="PlayButton" Grid.Column="3" Content="録音を再生" Click="Play_Click"/><Button x:Name="ExportButton" Grid.Column="4" Content="Markdown出力" Click="Export_Click"/>
            <TextBlock x:Name="StatusText" Grid.Column="5" Text="準備中…" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#45515E" TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</Window>
